{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Spotlight Bar",
  "version": "0.1.0",
  "identifier": "com.osb.launcher",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "tsc --noEmit && vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Spotlight Bar",
        "width": 940,
        "height": 108,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Keyboard-first cross-platform desktop launcher",
    "longDescription": "Open Spotlight Bar is a cross-platform desktop launcher focused on fast local search, keyboard-first actions, and a clean extensible architecture."
  }
}
