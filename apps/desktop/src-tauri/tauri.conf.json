{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse Launcher",
  "version": "0.1.0",
  "identifier": "com.pulse.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse Launcher",
        "width": 1180,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Keyboard-first local desktop launcher",
    "longDescription": "Pulse Launcher is a cross-platform desktop launcher focused on fast local search, keyboard-first actions, and a clean extensible architecture."
  }
}
